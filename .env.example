# Copy to .env — ADK loads it automatically.

# --- Vertex AI (the agent's model) ---------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ctoteam
GOOGLE_CLOUD_LOCATION=us-central1
PROFILER_MODEL=gemini-2.5-flash

# To use an AI Studio API key instead of Vertex AI, set these two instead:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-key

# --- Crawl limits ---------------------------------------------------------
PROFILER_MAX_FILES=25000
PROFILER_SAMPLE_BYTES=1048576
PROFILER_FULL_HASH_MAX_BYTES=33554432
PROFILER_RUN_ROOT=runs

# --- Sensitivity ----------------------------------------------------------
# Local heuristics always run. DLP escalates only the top-ranked files, and
# costs money — leave it off for demos, turn it on for real engagements.
PROFILER_USE_DLP=false
PROFILER_DLP_SAMPLE_LIMIT=100

# --- BigQuery inventory ---------------------------------------------------
PROFILER_BQ_DATASET=estate_profiler
PROFILER_BQ_TABLE=file_inventory
